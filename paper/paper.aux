\newlabel{fig:dist-r1-compare}{{7}{11}{Refined vs.\ native ($R{=}1$) stage-3 path for the standard (left) and weight-tied (right) ConvNeXt-T. \textbf {Top:} $\|x^{(R)}-x_{R{=}1}\|$ (solid) with both state norms for scale (dashed: refined; squares: native). \textbf {Bottom:} $\cos (x^{(R)},x_{R{=}1})$. Mean and P5--P95 over the same 500 images; massive channel ignored; dots mark the end of each native step. The switched stack accumulates angle at every block; the shared field saturates}{figure.7}{}}
\newlabel{fig:dist-r1-compare@cref}{{[figure][7][]7}{[1][9][]11}}
\newlabel{tab:undo}{{2}{11}{Pooled stage-3 trajectory statistics over 500 ImageNet images (massive channel ignored; coordinates with $|\Delta _i|$ above the per-image median). Weight-tied vs.\ standard ConvNeXt-T at native ($R{=}1$) and refined ($R{=}100$) resolution. Mean $\pm $ std across images}{table.2}{}}
\newlabel{tab:undo@cref}{{[table][2][]2}{[1][10][]11}}
\citation{alain2016probes}
\citation{belrose2023tuned}
\newlabel{fig:pooled-dynamics}{{8}{12}{Stage-3 coordinates pooled over 500 images ($R{=}100$; massive channel removed; $|\Delta _i|$ above the per-image median). \textbf {Top:} weight-tied ConvNeXt; \textbf {bottom:} ConvNeXt-T. \textbf {Left:} progress $p_i(t)=(x_i(t)-x_i(0))/\Delta _i$ (median and P5--P95; thin lines: random coordinates). \textbf {Middle:} velocity toward the final value, coordinates sorted by peak time (red: toward the end state; blue: away). \textbf {Right:} phase density $(p_i,\,h_i/\Delta _i)$. The shared field advances mostly monotonically; the switched stack reverses and rewrites features between blocks}{figure.8}{}}
\newlabel{fig:pooled-dynamics@cref}{{[figure][8][]8}{[1][10][]12}}
\newlabel{fig:prefix-acc}{{9}{12}{ImageNet top-1 (left) and cross-entropy (right) of each model's trained stage~4+head on stage~3 prefixes (full validation). After each prefix we skip the rest of stage~3 and decode. \textbf {Solid:} refined path ($R{=}20$, $\Delta t{=}0.05$). \textbf {Open markers:} native discrete prefixes ($R{=}1$) at block ends. Weight-tied features become usable early and smoothly; ConvNeXt-T postpones most of the gain until late in the stage}{figure.9}{}}
\newlabel{fig:prefix-acc@cref}{{[figure][9][]9}{[1][10][]12}}
