\newlabel{fig:kinematics-compare}{{3}{6}{Stage-3 kinematics over $T{=}9$ ($R{=}100$, Euler $\Delta t{=}0.01$; massive channel removed; mean and P5--P95 over $N{=}500$). \textbf {Top:} weight-tied ConvNeXt. \textbf {Bottom:} untied ConvNeXt-T. Columns: speed $\|v\|$, angular velocity $\omega $, acceleration $(\|a\|,a_t,a_n)$, curvature $\kappa {=}a_n/\|v\|^2$. On the untied row, pairs of micro-steps that straddle a block boundary are omitted from $\omega $, $a$ and $\kappa $: there $v$ is discontinuous and finite differences diverge as $\Delta t\!\to \!0$}{figure.3}{}}
\newlabel{fig:kinematics-compare@cref}{{[figure][3][]3}{[1][5][]6}}
\newlabel{tab:coherence}{{3}{6}{Basis-independent transport statistics of stage~3, mean over $500$ images (std across images $\le 0.021$ for straightness and $\le 0.035$ for cosines). Str.: $\|x_T-x_0\|$ over path length (arc at $R{=}100$, chords at $R{=}1$); chords: $\|x_T-x_0\|/\sum _k\|\Delta x_k\|$; $\overline {\cos }$: mean off-diagonal cosine; $E$: opposed fraction; align: mean $\cos (\Delta x_k,x_T-x_0)$; $t_{50}$: first $t$ with $p(t)\ge 0.5$}{table.3}{}}
\newlabel{tab:coherence@cref}{{[table][3][]3}{[1][6][]6}}
\citation{alain2016probes,belrose2023tuned}
\newlabel{fig:transport}{{4}{7}{Basis-independent transport statistics of stage~3 ($R{=}100$, $N{=}500$, massive channel removed). \textbf {Top left:} mean cosine between block increments $\Delta x_j$ and $\Delta x_k$ for a random untied stage of matched strength, the untied ConvNeXt-T and the weight-tied model. \textbf {Top right:} progress $p(t)$ along the chord $x_T-x_0$ (dashed: diagonal). \textbf {Bottom left:} survival $s_k$, the net projection of all later increments on $\Delta x_k$ in units of $\|\Delta x_k\|^2$ ($s_k<0$: later blocks oppose block $k$). \textbf {Bottom right:} alignment of each increment with the total displacement. Bands: P10--P90 over images}{figure.4}{}}
\newlabel{fig:transport@cref}{{[figure][4][]4}{[1][6][]7}}
\newlabel{fig:prefix-acc}{{5}{7}{Top-1 (left) and cross-entropy (right) of each model's frozen stage~4 and head on stage-3 prefixes (full validation). Solid: refined path ($R{=}20$, $\Delta t{=}0.05$); open markers: native prefixes at block ends}{figure.5}{}}
